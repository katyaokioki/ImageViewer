<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ImageViewer.Ui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Кисти оформления. ThemeManager заменяет их при смене темы, элементы ссылаются через DynamicResource -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#D9202020"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFEDEDED"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4FA3FF"/>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF2A2A2A"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Полупрозрачные панели поверх изображения -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="Button.dialog">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Application.Styles>
</Application>
