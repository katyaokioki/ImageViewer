<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageViewer.Ui.Controls"
        x:Class="ImageViewer.Ui.MainWindow"
        Title="Image Viewer"
        Width="1200" Height="800"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        DragDrop.AllowDrop="True">

    <Grid x:Name="RootGrid">
        <!-- Слой фона: цвет темы, свой цвет или «шахматка» -->
        <Border x:Name="BackgroundLayer"/>

        <!-- Область просмотра; положение картинки задаёт матрица из ZoomController -->
        <Canvas x:Name="ImageCanvas" ClipToBounds="True" Background="Transparent" Focusable="True">
            <Image x:Name="ImageView" Stretch="Fill" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Подсказка, когда ничего не открыто -->
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="🖼" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <TextBlock x:Name="PlaceholderText" Margin="0,12,0,0" FontSize="16" TextAlignment="Center"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="Откройте изображение: Ctrl+O или перетащите файл в окно&#x0a;F1 — справка по управлению"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingIndicator" Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="False" IsHitTestVisible="False">
            <TextBlock Text="Загрузка…" FontSize="14" Foreground="{DynamicResource ForegroundBrush}"/>
        </Border>

        <!-- Панель информации и гистограмма -->
        <Border x:Name="InfoPanel" Classes="panel" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="12" Width="340" IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding #RootGrid.Bounds.Height}">
                <StackPanel>
                    <TextBlock Text="Информация о файле" Classes="header"/>
                    <ItemsControl x:Name="InfoItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="115,*" Margin="0,1">
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="HistogramSection" Margin="0,12,0,0">
                        <DockPanel>
                            <CheckBox x:Name="LogScaleCheckBox" DockPanel.Dock="Right" Content="лог." Focusable="False"
                                      Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            <TextBlock Text="Гистограмма" Classes="header" VerticalAlignment="Center"/>
                        </DockPanel>
                        <controls:HistogramControl x:Name="HistogramView" Height="120"/>
                        <TextBlock x:Name="HistogramStats" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Строка состояния -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="PixelText" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock x:Name="FileText" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </DockPanel>
        </Border>

        <!-- Всплывающие сообщения -->
        <Border x:Name="Toast" Classes="panel" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" IsVisible="False" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" FontSize="14" TextWrapping="Wrap" MaxWidth="640"
                       Foreground="{DynamicResource ForegroundBrush}"/>
        </Border>
    </Grid>
</Window>
