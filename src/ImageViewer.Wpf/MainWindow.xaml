<Window x:Class="ImageViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageViewer.Wpf.Controls"
        Title="Image Viewer"
        Width="1200" Height="800"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        AllowDrop="True"
        UseLayoutRounding="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        Drop="OnDrop"
        DragOver="OnDragOver"
        DpiChanged="OnDpiChanged">

    <Grid x:Name="RootGrid">
        <!-- Слой фона: цвет темы, свой цвет или «шахматка» -->
        <Border x:Name="BackgroundLayer"/>

        <!-- Область просмотра. Картинка позиционируется матрицей из ZoomController -->
        <Canvas x:Name="ImageCanvas"
                ClipToBounds="True"
                Background="Transparent"
                SizeChanged="OnCanvasSizeChanged"
                MouseWheel="OnCanvasMouseWheel"
                MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                MouseMove="OnCanvasMouseMove"
                MouseDown="OnCanvasMouseDown"
                LostMouseCapture="OnCanvasLostMouseCapture">
            <Image x:Name="ImageView" Stretch="Fill" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False"/>
        </Canvas>

        <!-- Подсказка, когда ничего не открыто -->
        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="🖼" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            <TextBlock x:Name="PlaceholderText" Margin="0,12,0,0" FontSize="16" TextAlignment="Center"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="Откройте изображение: Ctrl+O или перетащите файл в окно&#x0a;F1 — справка по управлению"/>
        </StackPanel>

        <!-- Индикатор загрузки -->
        <Border x:Name="LoadingIndicator" Style="{StaticResource PanelBorderStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Загрузка…" Foreground="{DynamicResource ForegroundBrush}" FontSize="14"/>
        </Border>

        <!-- Панель информации о файле и гистограмма -->
        <Border x:Name="InfoPanel" Style="{StaticResource PanelBorderStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Width="330"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding ActualHeight, ElementName=RootGrid}">
                <StackPanel>
                    <TextBlock Text="Информация о файле" Style="{StaticResource PanelHeaderStyle}"/>
                    <ItemsControl x:Name="InfoItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource ForegroundBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="HistogramSection" Margin="0,12,0,0">
                        <DockPanel>
                            <CheckBox x:Name="LogScaleCheckBox" DockPanel.Dock="Right" Content="лог."
                                      VerticalAlignment="Center" Focusable="False"
                                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                                      Checked="OnLogScaleChanged" Unchecked="OnLogScaleChanged"/>
                            <TextBlock Text="Гистограмма" Style="{StaticResource PanelHeaderStyle}"/>
                        </DockPanel>
                        <controls:HistogramView x:Name="HistogramView" Height="120"/>
                        <TextBlock x:Name="HistogramStats" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Строка состояния -->
        <Border x:Name="StatusBar" VerticalAlignment="Bottom" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="PositionText" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0,0,16,0"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock x:Name="PixelText" DockPanel.Dock="Right" Margin="16,0,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock x:Name="FileText" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </DockPanel>
        </Border>

        <!-- Всплывающие сообщения -->
        <Border x:Name="Toast" Style="{StaticResource PanelBorderStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource ForegroundBrush}" FontSize="14" TextWrapping="Wrap" MaxWidth="600"/>
        </Border>
    </Grid>
</Window>
