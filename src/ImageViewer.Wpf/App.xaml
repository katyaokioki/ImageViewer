<Application x:Class="ImageViewer.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Значения по умолчанию (тёмная тема). ThemeManager заменяет эти кисти при смене темы,
             а элементы ссылаются на них через DynamicResource и обновляются автоматически. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF101010"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#D9202020"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFEDEDED"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#FFA0A0A0"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4FA3FF"/>
        <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF2A2A2A"/>

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="PanelHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
