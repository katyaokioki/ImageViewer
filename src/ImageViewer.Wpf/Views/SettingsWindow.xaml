<Window x:Class="ImageViewer.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ImageViewer.Wpf.Views"
        Title="Настройки — Image Viewer"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}">

    <Window.Resources>
        <views:EnumDisplayConverter x:Key="EnumDisplay"/>

        <DataTemplate x:Key="EnumItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
        </DataTemplate>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="ItemTemplate" Value="{StaticResource EnumItemTemplate}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <GroupBox Header="Внешний вид">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Тема" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedItem="{Binding Theme}"/>

                <TextBlock Grid.Row="1" Text="Фон" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="BackgroundBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding BackgroundMode}"/>

                <TextBlock Grid.Row="2" Text="Свой цвет фона" Style="{StaticResource LabelStyle}"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="28" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"/>
                    <TextBox x:Name="ColorBox" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnColorTextChanged" VerticalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Масштабирование" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="ScalingBox" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding ScalingQuality}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Просмотр">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Режим окна при запуске" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="WindowModeBox" Grid.Column="1" SelectedItem="{Binding WindowStartMode}"/>

                <TextBlock Grid.Row="1" Text="Масштаб по умолчанию" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="ZoomModeBox" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding DefaultZoomMode}"/>

                <TextBlock Grid.Row="2" Text="Шаг масштаба" Style="{StaticResource LabelStyle}"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                    <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" Foreground="{DynamicResource ForegroundBrush}">
                        <TextBlock.Text>
                            <Binding Path="ZoomStep" StringFormat="×{0:0.00}"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Minimum="1.05" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            Value="{Binding ZoomStep}"/>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Интервал слайд-шоу" Style="{StaticResource LabelStyle}"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <TextBlock DockPanel.Dock="Right" Width="48" TextAlignment="Right" Foreground="{DynamicResource ForegroundBrush}">
                        <TextBlock.Text>
                            <Binding Path="SlideshowIntervalSeconds" StringFormat="{}{0:0.#} с"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Minimum="1" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            Value="{Binding SlideshowIntervalSeconds}"/>
                </DockPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <CheckBox Content="Сбрасывать масштаб при переходе к другому изображению" IsChecked="{Binding ResetZoomOnNavigate}"/>
                    <CheckBox Content="Показывать строку состояния" IsChecked="{Binding ShowStatusBar}"/>
                    <CheckBox Content="Показывать панель информации" IsChecked="{Binding ShowInfoPanel}"/>
                    <CheckBox Content="Показывать гистограмму" IsChecked="{Binding ShowHistogram}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Header="Папка">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Сортировка" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="SortBox" Grid.Column="1" SelectedItem="{Binding SortMode}"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <CheckBox Content="По убыванию" IsChecked="{Binding SortDescending}"/>
                    <CheckBox Content="Переход по кругу (после последнего — первое)" IsChecked="{Binding WrapAround}"/>
                    <CheckBox Content="Открывать последний файл при запуске без параметров" IsChecked="{Binding RestoreLastFile}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="LocationText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="По умолчанию" Margin="0" Style="{StaticResource DialogButtonStyle}" Click="OnResetClick"/>
            <Button DockPanel.Dock="Right" Content="Отмена" IsCancel="True" Style="{StaticResource DialogButtonStyle}"/>
            <Button DockPanel.Dock="Right" Content="Сохранить" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="OnSaveClick"/>
        </DockPanel>
    </StackPanel>
</Window>
