<Window x:Class="ImageViewer.Wpf.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка — Image Viewer"
        Width="760" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="Esc или F1 — закрыть"/>
            <Button DockPanel.Dock="Right" Content="Закрыть" IsDefault="True" IsCancel="True"
                    Style="{StaticResource DialogButtonStyle}" Click="OnCloseClick"/>
            <Button DockPanel.Dock="Right" Content="Копировать" Style="{StaticResource DialogButtonStyle}" Click="OnCopyClick"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Image Viewer — управление" FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,12" Foreground="{DynamicResource ForegroundBrush}"/>
        <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource InputBackgroundBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                <TextBlock x:Name="HelpTextBlock" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                           Foreground="{DynamicResource ForegroundBrush}"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
